    "gatsby-plugin-mdx": "^5.15.0",
    "gatsby-plugin-manifest": "^5.15.0",
    "gatsby-plugin-postcss": "^6.15.0",
    "gatsby-plugin-offline": "^6.15.0",
    "gatsby-plugin-purgecss": "^6.2.1",
    "gatsby-plugin-svgr-svgo": "^2.0.0",
    "gatsby-remark-images": "^7.15.0",
    "gatsby-remark-prismjs": "^7.15.0",
    "gatsby-source-filesystem": "^5.15.0",
    "gatsby-transformer-remark": "^6.15.0",
    "gatsby-transformer-sharp": "^5.15.0",
    "gatsby-plugin-sharp": "^5.15.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "gatsby-plugin-react-helmet": "^6.15.0",
    "react-simple-line-icons": "^1.0.8",
    "react-typed": "^2.0.12"
  },
  "keywords": [
    "andriawan",
    "website",
    "portofolio"
  ],
  "license": "MIT",
  "scripts": {
    "analyze:lint": "eslint --ext .jsx --ext .js .",
    "analyze:prettier": "prettier --list-different \"**/*.{css,js,jsx,json,md}\"",
    "analyze": "npm run analyze:lint && npm run analyze:prettier",
    "fix:lint": "eslint --ext .jsx --ext .js . --fix",
    "fix:prettier": "prettier --write \"**/*.{css,js,jsx,json,md}\"",
    "fix": "npm run fix:lint && npm run fix:prettier",
    "build": "gatsby build",
    "develop": "gatsby develop",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\" && exit 1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "@svgr/webpack": "^8.1.0",
    "@babel/eslint-parser": "^7.28.6",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-react": "^7.30.0",
    "gatsby-cli": "^5.15.0",
    "git-commit-msg-linter": "^5.0.8",
    "prettier": "^3.8.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-dark-mode": "^1.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andriawan/andriawan.com"
  },
  "bugs": {
    "url": "https://github.com/andriawan/andriawan.com/issues"
  }
